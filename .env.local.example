# ====================================================================
# NajmiNet Innovations — Environment Configuration
# Copy this file to .env.local and fill in your values:
#   cp .env.local.example .env.local
#
# .env.local is the only file with real values. It is git-ignored and
# must NEVER be committed. The app reads it through
# includes/load_env.php; Docker reads the DB_* keys and
# MYSQL_ROOT_PASSWORD from it through docker/db-entrypoint.sh.
#
# Keep comments on their own line: an inline "# ..." becomes part of
# the value.
# ====================================================================

# -------------------------------------------------------------------
# Application
# -------------------------------------------------------------------
# Base URL used to build links in emails (password reset, newsletter).
APP_URL=http://localhost:8080

# -------------------------------------------------------------------
# Database (MySQL)
# DB_HOST is "db" inside Docker, 127.0.0.1 for a local MySQL.
# In Docker, DB_NAME / DB_USER / DB_PASS / MYSQL_ROOT_PASSWORD create the
# database the first time the volume starts empty. Changing them later
# does not change the passwords: use ALTER USER, then update this file.
# -------------------------------------------------------------------
DB_HOST=db
# Optional, defaults to 3306.
DB_PORT=3306
DB_NAME=najminet
DB_USER=najminet_user
DB_PASS=change_me
MYSQL_ROOT_PASSWORD=change_me_root

# -------------------------------------------------------------------
# Mail / SMTP
# Gmail: host smtp.gmail.com, port 587, encryption tls (STARTTLS).
# MAIL_PASSWORD must be a 16-character Gmail App Password (no spaces),
# not the account password, with 2-Step Verification on.
# Gmail only accepts a From address the account owns, so MAIL_USERNAME
# and MAIL_FROM should normally be the same mailbox.
# -------------------------------------------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=you@example.com
MAIL_PASSWORD=change_me
MAIL_FROM=you@example.com
MAIL_FROM_NAME=NajmiNet
# Optional: where replies go. Defaults to MAIL_FROM when empty.
MAIL_REPLY_TO=

# -------------------------------------------------------------------
# Contact form
# Mailbox that receives contact.php messages (they are also stored in
# the contact_messages table). Defaults to MAIL_FROM when empty.
# -------------------------------------------------------------------
CONTACT_TO=

# Public email address shown on the contact page. Leave empty (or keep
# the example.com placeholder) to hide the email block.
CONTACT_EMAIL=contact@example.com

# WhatsApp number behind the "Chat on WhatsApp" links (contact page and
# footer): international format, digits only, country code first, no
# "+" or leading 0. Leave empty (or keep the placeholder) to hide them.
CONTACT_WHATSAPP=2126XXXXXXXX

# -------------------------------------------------------------------
# Newsletter
# Address notified when a subscriber confirms. Leave empty to skip the
# notification.
# -------------------------------------------------------------------
NEWSLETTER_ADMIN_EMAIL=

# -------------------------------------------------------------------
# PayPal (Professional plan checkout)
# PAYPAL_MODE is sandbox or live.
# PAYPAL_MERCHANT_ID is the payer ID of the business account that must
# receive the money (sandbox: developer.paypal.com > Sandbox accounts >
# Business account > Account info). Captures paid to any other account
# are refused, and checkout is refused while it is empty.
# -------------------------------------------------------------------
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_MERCHANT_ID=your-paypal-merchant-id

# -------------------------------------------------------------------
# Google OAuth 2.0
# Create credentials at https://console.cloud.google.com/apis/credentials
# -------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/oauth/google.php
